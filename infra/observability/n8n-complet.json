{
  "nodes": [
    {
      "parameters": {
        "cronExpression": "*/5 * * * *"
      },
      "id": "Cron",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://prometheus:9090/-/healthy",
        "responseFormat": "string"
      },
      "id": "Check Prometheus",
      "name": "Check Prometheus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 100]
    },
    {
      "parameters": {
        "url": "http://grafana:3000/api/health",
        "responseFormat": "json"
      },
      "id": "Check Grafana",
      "name": "Check Grafana",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 180]
    },
    {
      "parameters": {
        "url": "http://loki:3100/ready",
        "responseFormat": "string"
      },
      "id": "Check Loki",
      "name": "Check Loki",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 260]
    },
    {
      "parameters": {
        "url": "http://promtail:9080/ready",
        "responseFormat": "string"
      },
      "id": "Check Promtail",
