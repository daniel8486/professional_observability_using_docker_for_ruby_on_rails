RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=MinhASuperSenha
GF_SECURITY_ADMIN_USER=user
GF_SECURITY_ADMIN_PASSWORD=MinhASuperSenha
RABBIT_USER=user
RABBIT_PASSWORD=MinhASuperSenha
DEVISE_JWT_KEY=TokenJWT
DATA_SOURCE_NAME=postgresql://postgres:senha@172.19.0.1:5432/seuBancoDeDados?sslmode=disable
REDIS_PASSWORD=senhaSeguraCasoExporRedis


# Para RabbitMQ
environment:
  RABBITMQ_DEFAULT_USER: ${RABBITMQ_DEFAULT_USER}
  RABBITMQ_DEFAULT_PASS: ${RABBITMQ_DEFAULT_PASS}
  TZ: America/Sao_Paulo

# Para Grafana
environment:
  GF_SECURITY_ADMIN_USER: ${GF_SECURITY_ADMIN_USER}
  GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD}
  GF_USERS_ALLOW_SIGN_UP: "false"
  TZ: America/Sao_Paulo

# Para Sidekiq
environment:
  REDIS_URL: redis://redis:6379/0
  RAILS_ENV: production
  DEVISE_JWT_KEY: ${DEVISE_JWT_KEY}
  TZ: America/Sao_Paulo

# Para Postgres Exporter
environment:
  DATA_SOURCE_NAME: ${DATA_SOURCE_NAME}
  TZ: America/Sao_Paulo